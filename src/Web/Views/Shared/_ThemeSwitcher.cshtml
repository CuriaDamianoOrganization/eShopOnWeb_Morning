<div class="esh-theme-switcher" role="group" aria-label="Color theme">
    <span class="esh-theme-switcher-label">Theme</span>
    <button type="button" class="esh-theme-switcher-option" data-theme-value="light" aria-pressed="false">Light</button>
    <button type="button" class="esh-theme-switcher-option" data-theme-value="dark" aria-pressed="false">Dark</button>
    <button type="button" class="esh-theme-switcher-option" data-theme-value="system" aria-pressed="true">System</button>
</div>
